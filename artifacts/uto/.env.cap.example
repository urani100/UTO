# Capacitor build secrets — copy this file to .env.cap.local and fill in real values.
#
#   cp .env.cap.example .env.cap.local
#
# .env.cap.local is gitignored and will never be committed.
# Run `pnpm run cap:build` (or `cap:sync`) after filling in values.

# Your Clerk publishable key — find it in Replit Secrets as CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk proxy URL — your deployed domain + /api/__clerk
VITE_CLERK_PROXY_URL=

# Base URL of your deployed API server (no trailing slash)
VITE_API_BASE_URL=
